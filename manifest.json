{
  "manifest_version": 3,
  "name": "Template Text Generator",
  "version": "1.4.1",
  "description": "One-click or shortcut copy of generated text from your saved templates, e.g. 'Work item {{number/8}}'.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Template Text Generator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "offscreen"
  ],
  "commands": {
    "copy-default": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Generate & copy the default config"
    },
    "copy-preset-1": {
      "description": "Generate & copy config #1 (first in your list)"
    },
    "copy-preset-2": {
      "description": "Generate & copy config #2"
    },
    "copy-preset-3": {
      "description": "Generate & copy config #3"
    }
  }
}